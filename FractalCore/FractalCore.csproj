<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <StripSymbols>true</StripSymbols>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FractalStreamer\FractalStreamer.csproj" />
    <ProjectReference Include="..\FractalBridge\FractalBridge.csproj" />
    <ProjectReference Include="..\FractalBltEncoder\FractalBltEncoder.csproj" />
    <ProjectReference Include="..\FractalGnnRouter\FractalGnnRouter.csproj" />
  </ItemGroup>
</Project>
